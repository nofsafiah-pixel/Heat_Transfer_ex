QWidget {
    color: #e8eef8;
    font-family: "Segoe UI";
    font-size: 13px;
}

#heatTransferWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #101827, stop: 0.55 #17243a, stop: 1 #1d2b45
    );
}

QLabel {
    background: transparent;
}

#pageEyebrow {
    color: #70d6d1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

#pageTitle {
    color: #f7f9fd;
    font-size: 34px;
    font-weight: 700;
}

#pageSubtitle {
    color: #aab8cb;
    font-size: 14px;
}

#leftBodyCard, #rightBodyCard, #bridgePanel {
    background-color: rgba(31, 45, 67, 230);
    border: 1px solid #354760;
    border-radius: 18px;
}

#leftBodyCard {
    border-top: 3px solid #ff9a76;
}

#rightBodyCard {
    border-top: 3px solid #70c4f4;
}

#bodyTitle {
    color: #f7f9fd;
    font-size: 21px;
    font-weight: 700;
}

#leftReservoirCaption, #rightReservoirCaption {
    color: #8fa2bb;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

#leftReservoirCaption {
    color: #ffad8b;
}

#rightReservoirCaption {
    color: #82cdf5;
}

QLabel#leftMaterialLabel, QLabel#rightMaterialLabel,
QLabel#leftTemperatureLabel, QLabel#rightTemperatureLabel,
QLabel#leftMassLabel, QLabel#rightMassLabel,
QLabel#leftHeatCapacityLabel, QLabel#rightHeatCapacityLabel,
#conductivityLabel {
    color: #c6d1e0;
    font-size: 12px;
    font-weight: 600;
}

QComboBox, QDoubleSpinBox {
    min-height: 38px;
    padding: 0 11px;
    color: #f5f7fb;
    background-color: #152238;
    border: 1px solid #425570;
    border-radius: 9px;
    selection-background-color: #3b82a0;
}

QComboBox:hover, QDoubleSpinBox:hover {
    border-color: #70d6d1;
}

QComboBox::drop-down {
    width: 30px;
    border: none;
}

QComboBox QAbstractItemView {
    color: #edf3fa;
    background-color: #1c2a40;
    border: 1px solid #425570;
    selection-background-color: #315b70;
    outline: none;
}

#leftTemperatureDisplay, #rightTemperatureDisplay {
    min-width: 108px;
    color: #28364a;
    background-color: #e6ebf0;
    border: 1px solid #c7d0da;
    font-size: 15px;
    font-weight: 700;
}

QSlider {
    min-height: 24px;
}

QSlider::groove:horizontal {
    height: 6px;
    background-color: #3a4b64;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #70d6d1;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    margin: -7px 0;
    background-color: #f7fbff;
    border: 3px solid #70bdbb;
    border-radius: 9px;
}

#bridgePanel {
    background-color: rgba(23, 36, 56, 235);
    border-color: #30425a;
}

#bridgeHeading {
    color: #72d9d3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.3px;
}

#bridgeBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #ff9a76, stop: 0.5 #d6bd8b, stop: 1 #70c4f4
    );
    border: 1px solid rgba(255, 255, 255, 45);
    border-radius: 9px;
}

#bridgeCaption {
    color: #f0f4fa;
    font-size: 16px;
    font-weight: 700;
}

#bridgeDescription {
    color: #9eafc4;
    font-size: 11px;
}

#startButton, #secondaryButton {
    min-height: 44px;
    padding: 0 20px;
    border-radius: 11px;
    font-weight: 700;
}

#startButton {
    color: #10232c;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #83e3d4, stop: 1 #56c5c8
    );
    border: 1px solid #a2f0e2;
}

#startButton:hover {
    background-color: #a0f0e2;
}

#startButton:checked {
    color: #f7f9fd;
    background-color: #326d75;
    border-color: #70d6d1;
}

#secondaryButton {
    color: #dce6f2;
    background-color: #25364e;
    border: 1px solid #465b77;
}

#secondaryButton:hover {
    background-color: #304661;
    border-color: #6b829f;
}

QPushButton:pressed {
    padding-top: 2px;
    padding-bottom: 0;
}
